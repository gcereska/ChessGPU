#pragma once

// Generated by CMake from src/gpu/variants.h.in: which variants the GPU
// kernels are compiled for. Choose with the CMake options CHESSGPU_BOARDS,
// CHESSGPU_MODELS, CHESSGPU_EVALS, CHESSGPU_ORDERINGS, CHESSGPU_STACKS,
// CHESSGPU_FEATURES, CHESSGPU_TT_LAYOUTS, CHESSGPU_ATTACKS, CHESSGPU_SEARCH_ATTACKS
// CHESSGPU_DEVICE_SEARCHES and CHESSGPU_MOVES.
// Disabled variants stay in the source; they just aren't instantiated, so
// they can be switched back on and re-tested at any time.

// Sliding-attack variants of the perft kernels (the searches use hq).
#define CHESSGPU_WITH_HQ_ATTACKS @CHESSGPU_WITH_HQ_ATTACKS@
#define CHESSGPU_WITH_MAGIC_ATTACKS @CHESSGPU_WITH_MAGIC_ATTACKS@
#define CHESSGPU_WITH_KOGGE_ATTACKS @CHESSGPU_WITH_KOGGE_ATTACKS@
// Sliding-attack variants of the search kernels.
#define CHESSGPU_WITH_HQ_SEARCH_ATTACKS @CHESSGPU_WITH_HQ_SEARCH_ATTACKS@
#define CHESSGPU_WITH_MAGIC_SEARCH_ATTACKS @CHESSGPU_WITH_MAGIC_SEARCH_ATTACKS@
// Move encodings of the perft kernels (bits; the search uses 16).
#define CHESSGPU_WITH_16_MOVES @CHESSGPU_WITH_16_MOVES@
#define CHESSGPU_WITH_32_MOVES @CHESSGPU_WITH_32_MOVES@
// Parallel searches run entirely on the GPU (one persistent kernel each).
#define CHESSGPU_WITH_YBWC_DEVICE_SEARCH @CHESSGPU_WITH_YBWC_DEVICE_SEARCH@
#define CHESSGPU_WITH_ABDADA_DEVICE_SEARCH @CHESSGPU_WITH_ABDADA_DEVICE_SEARCH@
#define CHESSGPU_WITH_STD_BOARD @CHESSGPU_WITH_STD_BOARD@
#define CHESSGPU_WITH_QUAD_BOARD @CHESSGPU_WITH_QUAD_BOARD@
#define CHESSGPU_WITH_THREAD_MODEL @CHESSGPU_WITH_THREAD_MODEL@
#define CHESSGPU_WITH_WARP_MODEL @CHESSGPU_WITH_WARP_MODEL@
#define CHESSGPU_WITH_MATERIAL_EVAL @CHESSGPU_WITH_MATERIAL_EVAL@
#define CHESSGPU_WITH_PESTO_EVAL @CHESSGPU_WITH_PESTO_EVAL@
#define CHESSGPU_WITH_TERMS_EVAL @CHESSGPU_WITH_TERMS_EVAL@
#define CHESSGPU_WITH_NNUE_EVAL @CHESSGPU_WITH_NNUE_EVAL@
// Thread model only (the warp model always orders with its own list).
#define CHESSGPU_WITH_STAGED_ORDERING @CHESSGPU_WITH_STAGED_ORDERING@
#define CHESSGPU_WITH_LIST_ORDERING @CHESSGPU_WITH_LIST_ORDERING@
// Thread model with staged ordering only.
#define CHESSGPU_WITH_LOCAL_STACK @CHESSGPU_WITH_LOCAL_STACK@
#define CHESSGPU_WITH_SHARED_STACK @CHESSGPU_WITH_SHARED_STACK@
// Search feature sets (core/feature_list.h: CHESSGPU_WITH_FEATURES_<Kind>),
// and table layouts (core/tt.h) for the sets with a transposition table.
@CB_FEATURE_DEFINES@#define CHESSGPU_WITH_PACKED64_LAYOUT @CHESSGPU_WITH_PACKED64_LAYOUT@
#define CHESSGPU_WITH_WIDE128_LAYOUT @CHESSGPU_WITH_WIDE128_LAYOUT@
