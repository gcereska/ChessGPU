// Generated by CMake from src/gpu/kernels.cu.in: the GPU search kernels (task
// batches, the GPU-resident YBWC and ABDADA) for feature set
// "@CB_FEATURES_NAME@" and table layout "@CB_LAYOUT_NAME@", for every compiled
// board and eval. One unit per combination of CHESSGPU_FEATURES and
// CHESSGPU_TT_LAYOUTS, so the variant matrix compiles in parallel.

#include "gpu/kernel_select.cuh"

namespace cb::gpu {

#define CB_KERNELS_FOR(Board, Eval)                                                                               \
    template SearchKernelChoice<Board> search_kernel_for<Board, Eval, @CB_FEATURES_TYPE@, @CB_LAYOUT_TYPE@>(        \
        const GpuSearchOptions&);                                                                                 \
    template YbwcKernelChoice ybwc_kernel_for<Board, Eval, @CB_FEATURES_TYPE@, @CB_LAYOUT_TYPE@>(                   \
        const GpuSearchOptions&);                                                                                 \
    template AbdadaKernel<Board> abdada_kernel_for<Board, Eval, @CB_FEATURES_TYPE@, @CB_LAYOUT_TYPE@>(              \
        const GpuSearchOptions&);

#if CHESSGPU_WITH_STD_BOARD && CHESSGPU_WITH_MATERIAL_EVAL
CB_KERNELS_FOR(StdBoard, MaterialEval)
#endif
#if CHESSGPU_WITH_STD_BOARD && CHESSGPU_WITH_PESTO_EVAL
CB_KERNELS_FOR(StdBoard, PestoEval)
#endif
#if CHESSGPU_WITH_STD_BOARD && CHESSGPU_WITH_TERMS_EVAL
CB_KERNELS_FOR(StdBoard, PestoTermsEval)
#endif
#if CHESSGPU_WITH_STD_BOARD && CHESSGPU_WITH_NNUE_EVAL
CB_KERNELS_FOR(StdBoard, NnueEval)
#endif
#if CHESSGPU_WITH_QUAD_BOARD && CHESSGPU_WITH_MATERIAL_EVAL
CB_KERNELS_FOR(QuadBoard, MaterialEval)
#endif
#if CHESSGPU_WITH_QUAD_BOARD && CHESSGPU_WITH_PESTO_EVAL
CB_KERNELS_FOR(QuadBoard, PestoEval)
#endif
#if CHESSGPU_WITH_QUAD_BOARD && CHESSGPU_WITH_TERMS_EVAL
CB_KERNELS_FOR(QuadBoard, PestoTermsEval)
#endif
#if CHESSGPU_WITH_QUAD_BOARD && CHESSGPU_WITH_NNUE_EVAL
CB_KERNELS_FOR(QuadBoard, NnueEval)
#endif

#undef CB_KERNELS_FOR

}  // namespace cb::gpu
